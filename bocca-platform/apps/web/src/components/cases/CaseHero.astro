---
import type { CaseStudyData } from '../../lib/sanity/types';
import SanityMedia from '../ui/SanityMedia.astro';

export interface Props {
  caseStudy: CaseStudyData;
}

const { caseStudy } = Astro.props as Props;
const details = caseStudy.projectDetails?.filter(
  (detail) => detail.label?.trim() && detail.value?.trim(),
);
---

<section class="case-hero" aria-labelledby="case-title">
  <div class="case-hero__content">
    <div class="case-hero__main">
      <h1 id="case-title">{caseStudy.title}</h1>
      <p class="type-body-lg">{caseStudy.introduction}</p>
    </div>

    {details.length > 0 && (
      <dl class="case-hero__details">
        {details.map((detail) => (
          <div>
            <dt>{detail.label}</dt>
            <dd>{detail.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>

  <SanityMedia
    media={caseStudy.heroMedia ?? null}
    ratio="free"
    class="case-hero__media"
    sizes="(max-width: 45rem) 100vw, 50vw"
    loading="eager"
  />
</section>

<style>
  .case-hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    min-height: 100dvh;
    background: var(--color-beige);
  }

  .case-hero__content {
    display: flex;
    grid-column: 1 / 7;
    flex-direction: column;
    justify-content: center;
    gap: clamp(5rem, 8vh, 8rem);
    padding: 10.5rem 4rem 6rem;
  }

  .case-hero__main {
    display: grid;
    gap: 1.5rem;
  }

  .case-hero__main h1 {
    white-space: pre-line;
  }

  .case-hero__details {
    display: grid;
    gap: 1.75rem;
    margin: 0;
  }

  .case-hero__details div {
    display: grid;
    gap: 0.5rem;
  }

  .case-hero__details dt {
    color: var(--color-bocca-red);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    line-height: var(--text-label--line-height);
    text-transform: uppercase;
  }

  .case-hero__details dd {
    margin: 0;
    font-size: var(--text-body-lg);
    font-weight: 300;
    line-height: var(--text-body-lg--line-height);
  }

  .case-hero > :global(.case-hero__media) {
    grid-column: 7 / 13;
    width: 100%;
    height: 100%;
    min-height: 100%;
  }

  @media (max-width: 64rem) {
    .case-hero__content {
      padding-right: 1.5rem;
      padding-left: 1.5rem;
    }

    .case-hero__main h1 {
      font-size: clamp(3.5rem, 8vw, 6rem);
    }
  }

  @media (max-width: 45rem) {
    .case-hero {
      grid-template-columns: 1fr;
      grid-template-rows: 45vh auto;
      min-height: 0;
    }

    .case-hero__content {
      grid-row: 2;
      grid-column: 1;
      gap: 3rem;
      padding: 3rem 1.5rem 4rem;
    }

    .case-hero > :global(.case-hero__media) {
      grid-row: 1;
      grid-column: 1;
      min-height: 45vh;
    }

    .case-hero__main h1 {
      font-size: 3.5rem;
    }

    .case-hero__details {
      gap: 1.5rem;
    }

    .case-hero__details dt {
      font-size: 1rem;
    }
  }
</style>
