---
import type { CaseStudyData } from '../../lib/sanity/types';
import { getCaseSectionStyle } from '../../lib/caseSectionColor';

export interface Props {
  caseStudy: CaseStudyData;
}

const { caseStudy } = Astro.props as Props;
const introduction = caseStudy.introduction?.trim();
const details =
  caseStudy.projectDetails?.filter(
    (detail) => detail.label?.trim() && detail.value?.trim(),
  ) ?? [];
---

<section
  class="case-hero case-section"
  style={getCaseSectionStyle(caseStudy.heroBackgroundColor, '#faf4f0')}
  aria-labelledby="case-title"
>
  <div class="case-hero__main">
    <h1 id="case-title">{caseStudy.title}</h1>
    {introduction && <p class="type-body-lg">{introduction}</p>}
  </div>

  {details.length > 0 && (
    <dl class="case-hero__details">
      {details.map((detail) => (
        <div>
          <dt>{detail.label}</dt>
          <dd>{detail.value}</dd>
        </div>
      ))}
    </dl>
  )}
</section>

<style>
  .case-hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: end;
    column-gap: var(--grid-gutter);
    min-height: 31.625rem;
    padding: 10.5rem var(--page-gutter) 6rem;
  }

  .case-hero__main {
    display: flex;
    grid-column: 2 / span 6;
    flex-direction: column;
    justify-content: end;
    gap: 1.5rem;
    min-width: 0;
  }

  .case-hero__main h1 {
    font-size: clamp(4rem, 5vw, var(--text-heading-1));
    overflow-wrap: anywhere;
    white-space: pre-line;
  }

  .case-hero__details {
    display: grid;
    grid-column: 9 / span 4;
    gap: 1.75rem;
    min-width: 0;
    margin: 0;
  }

  .case-hero__details div {
    display: grid;
    gap: 0.5rem;
  }

  .case-hero__details dt {
    color: var(--color-bocca-red);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    line-height: var(--text-label--line-height);
    text-transform: uppercase;
  }

  .case-hero__details dd {
    margin: 0;
    font-size: var(--text-body-lg);
    font-weight: 300;
    line-height: var(--text-body-lg--line-height);
    overflow-wrap: anywhere;
  }

  @media (max-width: 64rem) {
    .case-hero {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem;
      min-height: 0;
      padding-top: 11rem;
      padding-bottom: 5rem;
    }

    .case-hero__main,
    .case-hero__details {
      grid-column: auto;
    }

    .case-hero__main h1 {
      font-size: clamp(3rem, 7vw, 5rem);
    }
  }

  @media (max-width: 48rem) {
    .case-hero {
      grid-template-columns: 1fr;
      gap: 3.5rem;
      padding-top: 10rem;
      padding-bottom: 4rem;
    }

    .case-hero__main h1 {
      font-size: var(--text-heading-1);
    }

    .case-hero__details {
      gap: 1.5rem;
    }

    .case-hero__details dt {
      font-size: 1rem;
    }
  }
</style>
