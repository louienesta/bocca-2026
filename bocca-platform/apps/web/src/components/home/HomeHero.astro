---
import type { HomeHero as HomeHeroData } from '../../lib/sanity/types';

export interface Props {
  content: HomeHeroData;
}

const { content } = Astro.props;
---

<section class="home-hero" aria-labelledby="home-hero-heading">
  <div class="home-hero__grid">
    <div class="home-hero__copy">
      <h1 id="home-hero-heading">{content.heading}</h1>
      <p class="type-body-lg">{content.body}</p>
    </div>

    <div class="home-hero__media">
      {content.videoUrl ? (
        <video
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
        >
          <source
            src={content.videoUrl}
            type={content.videoMimeType || undefined}
          />
        </video>
      ) : (
        <div class="home-hero__placeholder" aria-hidden="true"></div>
      )}
    </div>
  </div>
</section>

<style>
  .home-hero {
    height: 100dvh;
    min-height: 40rem;
    overflow: hidden;
    background: var(--color-beige);
  }

  .home-hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    height: 100%;
  }

  .home-hero__copy {
    display: flex;
    grid-column: 1 / 5;
    flex-direction: column;
    justify-content: center;
    gap: 2rem;
    padding: 6rem 4rem 6rem 6rem;
  }

  .home-hero__copy h1 {
    font-size: clamp(3rem, 4.5vw, 6rem);
  }

  .home-hero__copy p {
    max-width: 34rem;
  }

  .home-hero__media {
    position: relative;
    grid-column: 5 / 13;
    overflow: hidden;
    background: var(--color-media);
  }

  .home-hero__media video,
  .home-hero__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-hero__media video {
    display: block;
    object-fit: cover;
  }

  .home-hero__placeholder {
    background: var(--color-media);
  }

  @media (max-width: 48rem) {
    .home-hero {
      height: auto;
      min-height: 100dvh;
    }

    .home-hero__grid {
      grid-template-columns: 1fr;
      grid-template-rows: 45vh auto;
      min-height: 100dvh;
    }

    .home-hero__media {
      grid-row: 1;
      grid-column: 1;
      height: 45vh;
    }

    .home-hero__copy {
      grid-row: 2;
      grid-column: 1;
      gap: 1.5rem;
      padding: 2.5rem 1.5rem 3rem;
    }
  }
</style>
