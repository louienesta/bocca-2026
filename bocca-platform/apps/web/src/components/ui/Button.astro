---
type Variant = 'primary' | 'secondary';

export interface Props {
  href?: string;
  variant?: Variant;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  target?: string;
  rel?: string;
  ariaLabel?: string;
}

const {
  href,
  variant = 'primary',
  class: className,
  type = 'button',
  disabled = false,
  target,
  rel,
  ariaLabel,
} = Astro.props;

const base =
  'inline-flex min-h-11 items-center justify-center rounded-control border px-4 pt-2.5 pb-3 font-display text-xl leading-none whitespace-nowrap no-underline transition-[scale,background-color,color,border-color,opacity] duration-(--animate-duration-control) ease-expressive motion-safe:hover:scale-110 motion-safe:active:scale-[0.98]';
const variants: Record<Variant, string> = {
  primary:
    'border-bordeaux bg-bordeaux text-white hover:border-bordeaux hover:bg-bordeaux',
  secondary:
    'border-bordeaux bg-transparent text-bordeaux hover:bg-bordeaux hover:text-white',
};
const disabledStyles = disabled
  ? 'pointer-events-none cursor-not-allowed opacity-45'
  : 'cursor-pointer';
---

{href ? (
  <a
    href={href}
    class:list={[base, variants[variant], disabledStyles, className]}
    target={target}
    rel={rel}
    aria-label={ariaLabel}
    aria-disabled={disabled ? 'true' : undefined}
    tabindex={disabled ? -1 : undefined}
  >
    <slot />
  </a>
) : (
  <button
    class:list={[base, variants[variant], disabledStyles, className]}
    type={type}
    disabled={disabled}
    aria-label={ariaLabel}
  >
    <slot />
  </button>
)}
